{
  "name": "creatordock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "icons:slice": "python scripts/slice-icons.py",
    "test:icons": "python scripts/slice-icons.py --check",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node scripts/preview-smoke.mjs",
    "test:e2e:browser": "playwright test",
    "test:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Start-CreatorDock.ps1",
    "test:shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-CreatorDockShortcuts.ps1",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@vite-pwa/assets-generator": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
